(ert-deftest lsp-proxy-peek-test-navigation-map-precedes-modal-maps-and-cleans-up ()
  (lsp-proxy-peek-test--with-source
    (let* ((modal-map (make-sparse-keymap))
           (lsp-proxy-peek-test--modal-active t)
           (emulation-mode-map-alists (list (list (cons 'lsp-proxy-peek-test--modal-active modal-map)))))
      (define-key modal-map (kbd "<left>") #'ignore)
      (define-key modal-map (kbd "C-g") #'ignore)
      (lsp-proxy-peek-definition)
      (let ((session lsp-proxy-peek--session))
        (should (eq (key-binding (kbd "<left>")) 'lsp-proxy-peek-backward))
        (should (eq (key-binding (kbd "C-g")) 'lsp-proxy-peek-abort))
        (should (lsp-proxy-peek--session-exit-map session))
        (lsp-proxy-peek-abort)
        (should-not (lsp-proxy-peek--session-exit-map session))
        (should (eq (key-binding (kbd "<left>")) 'ignore))
        (should lsp-proxy-peek-test--modal-active)))))

