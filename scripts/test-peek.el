(ert-deftest lsp-proxy-peek-test-unsaved-source-and-marker-survive ()
  (lsp-proxy-peek-test--with-source
    (let ((target (find-file-noselect target-file)) (lsp-proxy-peek-height 8))
      (with-current-buffer target (goto-char (point-max)) (insert ";; unsaved\n"))
      (lsp-proxy-peek-definition)
      (lsp-proxy-peek-test--reply peer (vector (lsp-proxy-peek-test--location target-file 0 7)))
      (let ((marker (lsp-proxy-peek--location-marker (lsp-proxy-peek--current-location lsp-proxy-peek--session))))
        (with-current-buffer target (goto-char (point-min)) (insert ";; before\n"))
        (lsp-proxy-peek--post-command)
