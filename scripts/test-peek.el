(ert-deftest lsp-proxy-peek-test-initial-empty-result-closes-and-discards-session ()
  (lsp-proxy-peek-test--with-source
    (dolist (command '(lsp-proxy-peek-definition lsp-proxy-peek-references
                      lsp-proxy-peek-implementations lsp-proxy-peek-type-definition
                      lsp-proxy-peek-declaration))
      (dolist (response '(nil []))
        (funcall command t)
        (let* ((session lsp-proxy-peek--session)
               (overlay (lsp-proxy-peek--session-overlay session))
               (request (lsp-proxy-peek-test--request peer))
               (callback (nth 1 (alist-get (plist-get request :id) (jsonrpc--continuations peer))))
               notice)
          (cl-letf (((symbol-function 'message)
                     (lambda (format-string &rest args)
                       (setq notice (apply #'format format-string args)))))
            (lsp-proxy-peek-test--reply peer response))
          (should (string-match-p "No results for" notice))
          (should-not lsp-proxy-peek-mode)
          (should-not lsp-proxy-peek--session)
          (should-not lsp-proxy-peek--last-session)
          (should-not (overlay-buffer overlay))
          (should-not (lsp-proxy-peek--session-exit-map session))
          (should-not (memq #'lsp-proxy-peek--post-command post-command-hook))
          (should-not (memq #'lsp-proxy-peek--source-closed kill-buffer-hook))
          (should-not (memq #'lsp-proxy-peek--source-closed change-major-mode-hook))
          (should (= (length (jsonrpc--continuations peer)) 0))
          (should-error (lsp-proxy-peek-restore) :type 'user-error)
          (funcall callback (vector (lsp-proxy-peek-test--location target-file)))
          (should-not lsp-proxy-peek-mode)
          (should-not (find-buffer-visiting target-file)))))))

(ert-deftest lsp-proxy-peek-test-nested-empty-result-retains-valid-history ()
  (lsp-proxy-peek-test--with-source
    (lsp-proxy-peek-definition)
    (lsp-proxy-peek-test--reply peer (vector (lsp-proxy-peek-test--location target-file)))
    (let* ((session lsp-proxy-peek--session)
           (query (lsp-proxy-peek--session-current session))
           (location (lsp-proxy-peek--current-location session)))
      (dolist (response '(nil []))
        (lsp-proxy-peek--query-at session (find-buffer-visiting target-file) 19 'textDocument/typeDefinition)
        (lsp-proxy-peek-test--reply peer response)
        (should lsp-proxy-peek-mode)
        (should (eq query (lsp-proxy-peek--session-current session)))
        (should (string-match-p "No results" (lsp-proxy-peek--session-status session)))
        (should (eq source (overlay-buffer (lsp-proxy-peek--session-overlay session))))
        (should-not (lsp-proxy-peek--location-branches location)))
      ;; Returning to Origin still retains the successful branch.
      (lsp-proxy-peek-backward)
      (lsp-proxy-peek--query-at session source (point) 'textDocument/typeDefinition)
      (lsp-proxy-peek-test--reply peer nil)
      (should lsp-proxy-peek-mode)
      (lsp-proxy-peek-forward)
      (should (eq query (lsp-proxy-peek--session-current session))))))

(ert-deftest lsp-proxy-peek-test-errors-and-timeouts-retain-parent ()
  (lsp-proxy-peek-test--with-source
    (lsp-proxy-peek-references t)
    (jsonrpc-connection-receive
     peer (list :jsonrpc "2.0" :id (plist-get (lsp-proxy-peek-test--request peer) :id)
                :error '(:code -32603 :message "Server indexing")))
    (should (equal (lsp-proxy-peek--session-status lsp-proxy-peek--session) "Server indexing"))
    (lsp-proxy-peek-references t)
    (let ((timer (nth 3 (alist-get (plist-get (lsp-proxy-peek-test--request peer) :id)
                                  (jsonrpc--continuations peer)))))
      (cancel-timer timer)
      (apply (timer--function timer) (timer--args timer))
      (should (string-match-p "timed out" (lsp-proxy-peek--session-status lsp-proxy-peek--session))))))

