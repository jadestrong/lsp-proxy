(ert-deftest lsp-proxy-peek-test-symbol-selector-does-not-read-or-switch ()
  (lsp-proxy-peek-test--with-source
    (lsp-proxy-peek-definition)
    (lsp-proxy-peek-test--reply peer (vector (lsp-proxy-peek-test--location target-file)))
    (let (map keep exit)
      (cl-letf (((symbol-function 'read-key) (lambda (&rest _) (ert-fail "Blocking key read")))
                ((symbol-function 'set-transient-map)
                 (lambda (m k e &rest _) (setq map m keep k exit e))))
        (lsp-proxy-peek-references)
        (let ((this-command 'lsp-proxy-peek--select-key)) (should (funcall keep)))
        (should (eq (lookup-key map "a") 'lsp-proxy-peek--select-key))
        (let* ((picks (lsp-proxy-peek--session-picks lsp-proxy-peek--session))
               (pick (seq-find (lambda (pick)
                                 (with-current-buffer (nth 2 pick)
                                   (save-excursion (goto-char (nth 1 pick))
                                     (equal (thing-at-point 'symbol t) "beta")))) picks)))
          (should pick)
          (dolist (key (string-to-list (car pick)))
            (let ((last-command-event key)) (lsp-proxy-peek--select-key)))
          (let ((this-command 'lsp-proxy-peek--select-key)) (should-not (funcall keep)))
          (funcall exit)
          (should (eq (plist-get (lsp-proxy-peek-test--request peer) :method) 'textDocument/references))
          (should (equal (plist-get (plist-get (plist-get (lsp-proxy-peek-test--request peer) :params) :params)
                                   :position) '(:line 1 :character 3)))
          (should (eq (window-buffer (selected-window)) source)))))))

