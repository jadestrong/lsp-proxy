        (should (string-match-p "unsaved" (overlay-get (lsp-proxy-peek--session-overlay lsp-proxy-peek--session)
                                                       'after-string)))
        (lsp-proxy-peek-abort)
        (should (buffer-live-p target))
        (should (buffer-modified-p target))))))

(ert-deftest lsp-proxy-peek-test-restore-history-without-requery ()
  (lsp-proxy-peek-test--with-source
    (lsp-proxy-peek-definition)
    (lsp-proxy-peek-test--reply peer (vector (lsp-proxy-peek-test--location target-file)))
    (let ((session lsp-proxy-peek--session)
          (query (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
      (lsp-proxy-peek-abort)
      (let ((count (length (lsp-proxy-peek-test--sent peer))))
        (with-temp-buffer
          (let ((host (current-buffer)))
            (lsp-proxy-peek-restore)
            (should (eq (current-buffer) host))
            (should (eq query (lsp-proxy-peek--session-current session)))
            (should (eq host (overlay-buffer (lsp-proxy-peek--session-overlay session))))))
        (should (= count (length (lsp-proxy-peek-test--sent peer))))))))

