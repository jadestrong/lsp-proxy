;;; test-peek.el --- Inline navigation regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'lsp-proxy-peek)
(require 'lsp-proxy-org)
(defvar lsp-proxy-peek-test--modal-active nil)

(defclass lsp-proxy-peek-test--peer (jsonrpc-connection)
  ((sent :initform nil :accessor lsp-proxy-peek-test--sent)))
(cl-defmethod jsonrpc-running-p ((_peer lsp-proxy-peek-test--peer)) t)
(cl-defmethod jsonrpc-connection-send ((peer lsp-proxy-peek-test--peer) &rest message)
  (jsonrpc--json-encode (plist-get message :params))
  (push message (lsp-proxy-peek-test--sent peer)))

(defun lsp-proxy-peek-test--request (peer)
  (seq-find (lambda (message) (plist-get message :id)) (lsp-proxy-peek-test--sent peer)))
(defun lsp-proxy-peek-test--reply (peer result &optional request)
  (with-temp-buffer
    (jsonrpc-connection-receive
     peer (list :jsonrpc "2.0" :id (plist-get (or request (lsp-proxy-peek-test--request peer)) :id)
                :result result))))
(defun lsp-proxy-peek-test--location (file &optional line char)
  (list :uri (lsp-proxy--path-to-uri file)
        :range (list :start (list :line (or line 0) :character (or char 0))
                     :end (list :line (or line 0) :character (+ (or char 0) 4)))))

(defmacro lsp-proxy-peek-test--with-source (&rest body)
  (declare (indent 0))
  `(let* ((root (file-name-as-directory (file-truename (make-temp-file "peek-test" t))))
          (source-file (expand-file-name "Source.el" root))
          (target-file (expand-file-name "Target.el" root))
          (other-file (expand-file-name "Other.el" root))
          (peer (make-instance 'lsp-proxy-peek-test--peer :name "peek-test"))
          (lsp-proxy--connection peer)
          (lsp-proxy-peek--last-session nil)
          (lsp-proxy-peek-height 4)
          opened changed source)
     (unwind-protect
         (progn
           (with-temp-file source-file (insert "(alpha)\n"))
           (with-temp-file target-file (insert "(defun alpha ()\n  (beta)\n  (gamma))\n"))
           (with-temp-file other-file (insert "(defun beta () t)\n"))
           (setq source (find-file-noselect source-file))
           (save-window-excursion
             (set-window-buffer (selected-window) source)
             (with-current-buffer source
               (goto-char 2)
               (setq-local lsp-proxy-mode t lsp-proxy--has-any-servers t lsp-proxy--buffer-opened t)
               (cl-letf (((symbol-function 'jsonrpc-request)
                          (lambda (&rest _) (ert-fail "Synchronous peek request")))
                         ((symbol-function 'lsp-proxy--ensure-connection) #'ignore)
                         ((symbol-function 'lsp-proxy--send-did-change)
                          (lambda () (push (current-buffer) changed)))
                         ((symbol-function 'lsp-proxy-mode)
                          (lambda (&optional _) (setq-local lsp-proxy-mode t)))
                         ((symbol-function 'lsp-proxy--on-doc-open)
                          (lambda () (setq-local lsp-proxy--buffer-opened t)
                            (push (lsp-proxy--TextDocumentIdentifier) opened))))
                 ,@body))))
       (when (and lsp-proxy-peek--last-session
                  (buffer-live-p (lsp-proxy-peek--session-host lsp-proxy-peek--last-session)))
         (with-current-buffer (lsp-proxy-peek--session-host lsp-proxy-peek--last-session)
           (lsp-proxy-peek-abort)))
       (dolist (file (list source-file target-file other-file))
         (when-let* ((buffer (find-buffer-visiting file)))
           (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer)))
       (delete-directory root t))))

(ert-deftest lsp-proxy-peek-test-wire-methods-and-inline-render ()
  (lsp-proxy-peek-test--with-source
    (dolist (entry '((lsp-proxy-peek-definition . textDocument/definition)
                     (lsp-proxy-peek-references . textDocument/references)
                     (lsp-proxy-peek-implementations . textDocument/implementation)
                     (lsp-proxy-peek-type-definition . textDocument/typeDefinition)
                     (lsp-proxy-peek-declaration . textDocument/declaration)))
      (let ((window (selected-window)) (point (point)) (text (buffer-string)))
        (funcall (car entry) t)
        (let* ((request (lsp-proxy-peek-test--request peer))
               (envelope (plist-get request :params))
               (params (plist-get envelope :params)))
          (should (eq (plist-get request :method) (cdr entry)))
          (should (equal (plist-get envelope :uri) (lsp-proxy--path-to-uri source-file)))
          (should (equal (plist-get params :position) '(:line 0 :character 1)))
          (should (eq (plist-get (plist-get params :context) :includeDeclaration)
                      (eq (cdr entry) 'textDocument/references)))
          (should (= (length (jsonrpc--continuations peer)) 1))
          (lsp-proxy-peek-test--reply peer (vector (lsp-proxy-peek-test--location target-file 0 7)))
          (should (= (length (jsonrpc--continuations peer)) 0)))
        (should (eq (current-buffer) source))
        (should (eq (selected-window) window))
        (should (eq (window-buffer window) source))
        (should (= (point) point))
        (should (equal (buffer-string) text))
        (should-not (buffer-modified-p))
        (let ((overlay (lsp-proxy-peek--session-overlay lsp-proxy-peek--session)))
          (should (eq (overlay-buffer overlay) source))
          (should (eq (overlay-get overlay 'window) window))
          (should (string-match-p "beta" (overlay-get overlay 'after-string))))))))

(ert-deftest lsp-proxy-peek-test-nested-query-routes-target-and-keeps-point ()
  (lsp-proxy-peek-test--with-source
    (lsp-proxy-peek-definition)
    (lsp-proxy-peek-test--reply peer (vector (lsp-proxy-peek-test--location target-file 0 7)))
    (let* ((target (find-buffer-visiting target-file)) (old-point (with-current-buffer target (point))))
      (lsp-proxy-peek--query-at lsp-proxy-peek--session target 19 'textDocument/references)
      (let* ((request (lsp-proxy-peek-test--request peer)) (envelope (plist-get request :params)))
        (should (equal (plist-get envelope :uri) (lsp-proxy--path-to-uri target-file)))
        (should (equal (plist-get (plist-get (plist-get envelope :params) :textDocument) :uri)
                       (lsp-proxy--path-to-uri target-file)))
        (should (equal opened (list (list :uri (lsp-proxy--path-to-uri target-file)))))
        (should (memq target changed)))
      (lsp-proxy-peek-test--reply peer (vector (lsp-proxy-peek-test--location other-file 0 7)))
      (should (= old-point (with-current-buffer target (point))))
      (should (eq (window-buffer (selected-window)) source))
      (should (lsp-proxy-peek--query-parent (lsp-proxy-peek--session-current lsp-proxy-peek--session))))))

(ert-deftest lsp-proxy-peek-test-result-scrolling-and-branch-history ()
  (lsp-proxy-peek-test--with-source
    (lsp-proxy-peek-references)
    (lsp-proxy-peek-test--reply peer
                                (vector (lsp-proxy-peek-test--location target-file 0 7)
                                        (lsp-proxy-peek-test--location other-file 0 7)))
    (let ((parent (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
      (lsp-proxy-peek-next-result)
      (should (= (lsp-proxy-peek--query-index parent) 1))
      (lsp-proxy-peek-previous-result)
      (lsp-proxy-peek-next-line)
      (let ((offset (lsp-proxy-peek--location-offset (lsp-proxy-peek--current-location lsp-proxy-peek--session))))
        (lsp-proxy-peek--query-at lsp-proxy-peek--session (find-buffer-visiting target-file) 19
                                  'textDocument/definition)
        (lsp-proxy-peek-test--reply peer (vector (lsp-proxy-peek-test--location other-file)))
        (let ((first (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
          (lsp-proxy-peek-backward)
          (should (eq parent (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
          (should (= offset (lsp-proxy-peek--location-offset
                             (lsp-proxy-peek--current-location lsp-proxy-peek--session))))
          (lsp-proxy-peek--query-at lsp-proxy-peek--session (find-buffer-visiting target-file) 28
                                    'textDocument/implementation)
          (lsp-proxy-peek-test--reply peer (vector (lsp-proxy-peek-test--location source-file)))
          (let ((second (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
            (lsp-proxy-peek-previous-branch)
            (should (eq first (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
            (lsp-proxy-peek-next-branch)
            (should (eq second (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
            (lsp-proxy-peek-backward)
            (lsp-proxy-peek-forward)
            (should (eq second (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
            (should (= (length (lsp-proxy-peek--location-branches
                               (aref (lsp-proxy-peek--query-locations parent) 0))) 2))))))))

(ert-deftest lsp-proxy-peek-test-cancel-real-continuation-and-late-response ()
  (lsp-proxy-peek-test--with-source
    (lsp-proxy-peek-definition)
    (let* ((session lsp-proxy-peek--session) (request (lsp-proxy-peek-test--request peer))
           (continuation (alist-get (plist-get request :id) (jsonrpc--continuations peer)))
           (query (lsp-proxy-peek--session-current session)))
      (lsp-proxy-peek-abort)
      (should (= (length (jsonrpc--continuations peer)) 0))
      (should (eq (plist-get (car (lsp-proxy-peek-test--sent peer)) :method) '$/cancelRequest))
      (should (equal (plist-get (plist-get (car (lsp-proxy-peek-test--sent peer)) :params) :uri)
                     (lsp-proxy--path-to-uri source-file)))
      ;; Also exercise the captured callback, even if a transport queued it.
      (funcall (nth 1 continuation) (vector (lsp-proxy-peek-test--location target-file)))
      (should (eq query (lsp-proxy-peek--session-current session)))
      (should-not (find-buffer-visiting target-file))
      (should-not (lsp-proxy-peek--session-overlay session)))))

(ert-deftest lsp-proxy-peek-test-moving-back-invalidates-query ()
  (lsp-proxy-peek-test--with-source
    (lsp-proxy-peek-definition)
    (let* ((request (lsp-proxy-peek-test--request peer))
