           (origin (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
      (lsp-proxy-peek-backward)
      (funcall callback (vector (lsp-proxy-peek-test--location target-file)))
      (should (eq origin (lsp-proxy-peek--session-current lsp-proxy-peek--session)))
