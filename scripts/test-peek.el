(ert-deftest lsp-proxy-peek-test-decompiled-preview-is-asynchronous ()
  (lsp-proxy-peek-test--with-source
    (require 'lsp-proxy-java-jdtls)
    (let* ((uri "jdt://contents/java.base/java.lang/System.class?peek-test")
           (lsp-proxy-java--content-cache (make-hash-table :test 'equal))
           (location (list :uri uri :range '(:start (:line 0 :character 6) :end (:line 0 :character 12)))))
      (lsp-proxy-peek-definition)
      (lsp-proxy-peek-test--reply peer (vector location))
      (let* ((request (lsp-proxy-peek-test--request peer)) (envelope (plist-get request :params)))
        (should (eq (plist-get request :method) 'emacs/forwardRequest))
        (should (equal (plist-get envelope :uri) (lsp-proxy--path-to-uri source-file)))
        (should (equal (plist-get (plist-get (plist-get envelope :params) :params) :uri) uri)))
      (should (string-match-p "Loading source" (lsp-proxy-peek--session-status lsp-proxy-peek--session)))
      (lsp-proxy-peek-test--reply peer "class System { void exit() {} }\n")
      (let ((marker (lsp-proxy-peek--location-marker (lsp-proxy-peek--current-location lsp-proxy-peek--session))))
        (should (buffer-live-p (marker-buffer marker)))
        (should (= (marker-position marker) 7))
        (lsp-proxy-peek--query-at lsp-proxy-peek--session (marker-buffer marker) 21 'textDocument/definition)
        (let ((context (plist-get (lsp-proxy-peek-test--request peer) :params)))
          (should (equal (plist-get context :uri) (lsp-proxy--path-to-uri source-file)))
          (should (equal (plist-get (plist-get (plist-get context :params) :textDocument) :uri) uri)))))))

(ert-deftest lsp-proxy-peek-test-missing-source-never-creates-a-file ()
