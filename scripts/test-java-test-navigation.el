;;; test-java-test-navigation.el --- Java test navigation regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'lsp-proxy)

(defmacro lsp-proxy-test-nav--with-source (&rest body)
  (declare (indent 0))
  `(let* ((root (make-temp-file "java-test-navigation" t))
          (file (expand-file-name "Widget.java" root))
          (connection (list 'connection))
          (lsp-proxy--connection connection)
          success failure timeout request visits markers reports)
     (unwind-protect
         (progn
           (with-temp-file file (insert "class Widget {}"))
           (with-temp-buffer
             (setq buffer-file-name file)
             (insert "class Widget { /* unsaved */ }")
             (setq-local lsp-proxy-mode t lsp-proxy--buffer-opened t)
             (cl-letf (((symbol-function 'lsp-proxy--ensure-connection) #'ignore)
                       ((symbol-function 'lsp-proxy--send-did-change) #'ignore)
                       ((symbol-function 'lsp-proxy--build-params)
                        (lambda (params) (list :uri (lsp-proxy--path-to-uri file) :params params)))
                       ((symbol-function 'jsonrpc-request)
                        (lambda (&rest _) (ert-fail "Navigation used synchronous RPC")))
                       ((symbol-function 'jsonrpc-async-request)
                        (lambda (conn method params &rest args)
                          (setq request (list conn method params)
                                success (plist-get args :success-fn)
                                failure (plist-get args :error-fn)
                                timeout (plist-get args :timeout-fn))))
                       ((symbol-function 'xref-push-marker-stack)
                        (lambda () (push (point) markers)))
                       ((symbol-function 'lsp-proxy--goto-uri-position)
                        (lambda (&rest args) (push args visits)))
                       ((symbol-function 'lsp-proxy--info)
                        (lambda (&rest args) (push args reports)))
                       ((symbol-function 'lsp-proxy--error)
                        (lambda (&rest args) (push args reports))))
               ,@body)))
       (delete-directory root t))))

(defun lsp-proxy-test-nav--item (name uri rank &optional external)
  (list :simpleName name :fullyQualifiedName (concat "example." name)
        :uri uri :relevance rank :outOfBelongingProject (or external :json-false)))

(ert-deftest lsp-proxy-test-nav-wire-and-single-result ()
  (lsp-proxy-test-nav--with-source
    (lsp-proxy-java-go-to-test)
    (should (eq (car request) connection))
    (should (eq (cadr request) 'emacs/forwardRequest))
    (let* ((forward (plist-get (nth 2 request) :params))
           (command (plist-get forward :params)))
      (should (equal (plist-get forward :serverName) "jdtls"))
      (should (equal (plist-get forward :uri) (lsp-proxy--path-to-uri file)))
      (should (equal (plist-get forward :method) "workspace/executeCommand"))
      (should (equal (plist-get command :command) "vscode.java.test.navigateToTestOrTarget"))
      (should (equal (plist-get command :arguments) (vector (lsp-proxy--path-to-uri file) t))))
    (should-not visits)
    (let ((start (point)))
      (goto-char (point-min))
      (funcall success (list :items (vector (lsp-proxy-test-nav--item "WidgetTest" "file:///project/WidgetTest.java" 0))))
      (should (equal markers (list start))))
    (should (equal visits '(("file:///project/WidgetTest.java" 0 0))))
    (should (= (length markers) 1))
    (should (buffer-modified-p))))

(ert-deftest lsp-proxy-test-nav-subject-uses-json-false ()
  (lsp-proxy-test-nav--with-source
    (lsp-proxy-java-go-to-test-subject)
    (should (eq (aref (plist-get (plist-get (plist-get (nth 2 request) :params) :params) :arguments) 1) :json-false))
    (funcall success nil)
    (should (string-match-p "subjects" (cadr (car reports))))))

(ert-deftest lsp-proxy-test-nav-sorts-project-relevance-name-and-uri ()
  (let* ((items (list (lsp-proxy-test-nav--item "External" "file:///external.java" -100 t)
                      (lsp-proxy-test-nav--item "B" "file:///b.java" 0)
                      (lsp-proxy-test-nav--item "A" "file:///z.java" 0)
                      (lsp-proxy-test-nav--item "A" "file:///a.java" 0)
                      (lsp-proxy-test-nav--item "Exact" "file:///exact.java" -2147483648)))
         (original (copy-sequence items)))
    (should (equal (mapcar (lambda (item) (plist-get item :uri))
                          (lsp-proxy-java-test--sorted-items items))
                   '("file:///exact.java" "file:///a.java" "file:///z.java" "file:///b.java" "file:///external.java")))
    (should (equal items original))))

(ert-deftest lsp-proxy-test-nav-multiple-results-have-unique-choices ()
  (lsp-proxy-test-nav--with-source
    (let (choices)
      (cl-letf (((symbol-function 'lsp-proxy--completing-read)
                 (lambda (_prompt candidates &rest _) (setq choices candidates) (cadr candidates))))
        (lsp-proxy-java-test--visit
         (list :items (list (lsp-proxy-test-nav--item "Same" "file:///one/Test.java" 0)
                             (lsp-proxy-test-nav--item "Same" "file:///two/Test.java" 0))) nil))
      (should (= (length (delete-dups (copy-sequence choices))) 2))
      (should (equal visits '(("file:///two/Test.java" 0 0)))))))

(ert-deftest lsp-proxy-test-nav-empty-and-cancel-do-not-jump ()
  (lsp-proxy-test-nav--with-source
    (lsp-proxy-java-test--visit '(:items []) nil)
    (should reports)
    (cl-letf (((symbol-function 'lsp-proxy--completing-read)
               (lambda (&rest _) (signal 'quit nil))))
      (lsp-proxy-java-test--visit
       (list :items (list (lsp-proxy-test-nav--item "A" "file:///a.java" 0)
                           (lsp-proxy-test-nav--item "B" "file:///b.java" 0))) nil))
    (should-not markers)
    (should-not visits)))

(ert-deftest lsp-proxy-test-nav-errors-and-timeouts-are-visible ()
  (lsp-proxy-test-nav--with-source
    (lsp-proxy-java-go-to-test)
    (funcall failure '(:message "No delegateCommandHandler"))
    (funcall timeout)
    (should (= (length reports) 2))
    (should-not visits)))

(ert-deftest lsp-proxy-test-nav-obsolete-callbacks-do-not-jump ()
  (lsp-proxy-test-nav--with-source
    (lsp-proxy-java-go-to-test)
    (let ((old success))
      (lsp-proxy-java-go-to-test-subject)
      (funcall old '(:items [(:uri "file:///old.java")]))
      (should-not visits))
    (setq lsp-proxy--connection (list 'replacement))
    (funcall success '(:items [(:uri "file:///replacement.java")]))
    (should-not visits)
    (setq lsp-proxy--connection connection buffer-file-name "/different.java")
    (funcall success '(:items [(:uri "file:///wrong-file.java")]))
    (should-not visits)))

(ert-deftest lsp-proxy-test-nav-reads-complete-selected-bundle-manifest ()
  (let* ((directory (make-temp-file "java-test-manifest" t))
         (lsp-proxy-java-test-install-dir directory)
         (root (expand-file-name lsp-proxy-java-test-version directory))
         (names '("com.microsoft.java.test.plugin-0.43.1.jar" "junit-api.jar")))
    (unwind-protect
        (progn
          (make-directory root)
          (dolist (name names) (with-temp-file (expand-file-name name root)))
          (with-temp-file (expand-file-name "test-install.json" root)
            (insert (json-serialize (list :version lsp-proxy-java-test-version :bundles (vconcat names)))))
          (should (equal (lsp-proxy-java-test-bundles)
                         (mapcar (lambda (name) (expand-file-name name root)) names)))
          (delete-file (expand-file-name "junit-api.jar" root))
          (should-not (lsp-proxy-java-test-bundles)))
      (delete-directory directory t))))

(ert-deftest lsp-proxy-test-nav-install-is-async-and-clears-progress ()
  (let (request success failure timeout cleared)
    (cl-letf (((symbol-function 'lsp-proxy--ensure-connection) #'ignore)
              ((symbol-function 'lsp-proxy--set-global-status) #'ignore)
              ((symbol-function 'lsp-proxy--clear-global-status)
               (lambda () (cl-incf cleared)))
              ((symbol-function 'lsp-proxy--error) #'ignore)
              ((symbol-function 'message) #'ignore)
              ((symbol-function 'jsonrpc-request)
               (lambda (&rest _) (ert-fail "Installer used synchronous RPC")))
              ((symbol-function 'jsonrpc-async-request)
               (lambda (_connection method params &rest args)
                 (setq request (list method params)
                       success (plist-get args :success-fn)
                       failure (plist-get args :error-fn)
                       timeout (plist-get args :timeout-fn)))))
      (setq cleared 0)
      (lsp-proxy-java-install-test t)
      (should (eq (car request) 'emacs/installJavaTest))
      (should (eq (plist-get (plist-get (cadr request) :params) :force) t))
      (funcall success '(:version "0.47.0"))
      (funcall failure '(:message "Download failed"))
      (funcall timeout)
      (should (= cleared 3)))))

(ert-deftest lsp-proxy-test-nav-java-file-uri-format-is-supported ()
  (with-temp-buffer
    (should (equal (lsp-proxy--uri-to-path "file:/tmp/Widget%20Test.java")
                   "/tmp/Widget Test.java"))))

