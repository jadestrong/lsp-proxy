;;; test-java-production-files.el --- Production navigation regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'lsp-proxy)

(defmacro lsp-proxy-test-files--with-source (&rest body)
  (declare (indent 0))
  `(let* ((root (file-name-as-directory (file-truename (make-temp-file "java-production-files" t))))
          (file (expand-file-name "Widget.java" root))
          (connection (list 'connection))
          (lsp-proxy--connection connection)
          (lsp-proxy-java-files--cache (make-hash-table :test 'equal))
          (lsp-proxy-java-files--epoch 0)
          (lsp-proxy-java-files--lifecycle 0)
          (lsp-proxy-java-file-extensions '("java"))
          (lsp-proxy-java-file-include-generated t)
          (lsp-proxy-java-file-cache-duration 30)
          requests success failure timeout timers choices metadata visits markers reports)
     (unwind-protect
         (progn
           (with-temp-file file (insert "class Widget {}"))
           (with-temp-buffer
             (setq buffer-file-name file default-directory root)
             (insert "class Widget { /* unsaved */ }")
             (setq-local lsp-proxy-mode t lsp-proxy--buffer-opened t
                         lsp-proxy--workspace-roots (list root))
             (cl-letf (((symbol-function 'lsp-proxy--ensure-connection) #'ignore)
                       ((symbol-function 'lsp-proxy--send-did-change) #'ignore)
                       ((symbol-function 'project-current) (lambda (&rest _) nil))
                       ((symbol-function 'jsonrpc-request)
                        (lambda (&rest _) (ert-fail "Production search used synchronous RPC")))
                       ((symbol-function 'jsonrpc-async-request)
                        (lambda (conn method params &rest args)
                          ;; Exercise jsonrpc's real encoder, including null and false.
                          (jsonrpc--json-encode params)
                          (push (list conn method params) requests)
                          (setq success (plist-get args :success-fn)
                                failure (plist-get args :error-fn)
                                timeout (plist-get args :timeout-fn))))
                       ((symbol-function 'run-at-time)
                        (lambda (_delay _repeat function &rest args)
                          (push (cons function args) timers)))
                       ((symbol-function 'active-minibuffer-window) (lambda () nil))
                       ((symbol-function 'lsp-proxy--completing-read)
                        (lambda (_prompt table)
                          (setq choices (all-completions "" table)
                                metadata (completion-metadata "" table nil))
                          (car choices)))
                       ((symbol-function 'xref-push-marker-stack)
                        (lambda () (push (point) markers)))
                       ((symbol-function 'find-file)
                        (lambda (target &rest _) (push target visits)))
                       ((symbol-function 'lsp-proxy--info)
                        (lambda (&rest args) (push args reports)))
                       ((symbol-function 'lsp-proxy--warn)
                        (lambda (&rest args) (push args reports)))
                       ((symbol-function 'lsp-proxy--error)
                        (lambda (&rest args) (push args reports))))
               ,@body)))
       (delete-directory root t))))

(defmacro lsp-proxy-test-files--drain ()
  `(while timers
     (let ((timer (pop timers))) (apply (car timer) (cdr timer)))))

(ert-deftest lsp-proxy-files-wire-async-completion-and-return-position ()
  (lsp-proxy-test-files--with-source
    (lsp-proxy-java-find-production-file)
    (should (eq (caar requests) connection))
    (should (eq (cadar requests) 'emacs/javaProductionFiles))
    (let ((params (plist-get (nth 2 (car requests)) :params)))
      (should (equal (plist-get params :projectUri) (lsp-proxy--path-to-uri root)))
      (should (equal (plist-get params :serverName) "jdtls"))
      (should (equal (plist-get params :extensions) ["java"]))
      (should (eq (plist-get params :includeGenerated) t)))
    (should-not visits)
    (let ((position (point)))
      (goto-char (point-min))
      (funcall success (list :files (vector file)))
      (should-not visits)
      (lsp-proxy-test-files--drain)
      (should (equal markers (list position))))
    (should (equal visits (list file)))
    (should (eq (completion-metadata-get metadata 'category) 'file))
    (should (buffer-modified-p))))

(ert-deftest lsp-proxy-files-project-boundary-overrides-module-root ()
  (lsp-proxy-test-files--with-source
    (setq-local lsp-proxy--workspace-roots (list (expand-file-name "module/" root)))
    (cl-letf (((symbol-function 'project-current) (lambda (&rest _) '(fake-project)))
              ((symbol-function 'project-root) (lambda (_) root)))
      (lsp-proxy-java-find-production-file))
    (should (equal (plist-get (plist-get (nth 2 (car requests)) :params) :projectUri)
                   (lsp-proxy--path-to-uri root)))))

(ert-deftest lsp-proxy-files-cache-hit-and-prefix-refresh ()
  (lsp-proxy-test-files--with-source
    (lsp-proxy-java-find-production-file)
    (funcall success (list :files (vector file)))
    (lsp-proxy-test-files--drain)
    (lsp-proxy-java-find-production-file)
    (lsp-proxy-test-files--drain)
    (should (= (length requests) 1))
    (should (= (length visits) 2))
    (lsp-proxy-java-find-production-file '(4))
    (should (= (length requests) 2))
    (should (= (hash-table-count lsp-proxy-java-files--cache) 0))))

(ert-deftest lsp-proxy-files-cache-expiry-zero-and-option-changes ()
  (lsp-proxy-test-files--with-source
    (lsp-proxy-java-find-production-file)
    (funcall success (list :files (vector file)))
    (lsp-proxy-test-files--drain)
    (let ((lsp-proxy-java-file-include-generated nil)
          (lsp-proxy-java-file-extensions nil))
      (lsp-proxy-java-find-production-file)
      (let ((params (plist-get (nth 2 (car requests)) :params)))
        (should-not (plist-get params :extensions))
        (should (eq (plist-get params :includeGenerated) :json-false))))
    (let ((lsp-proxy-java-file-cache-duration 0))
      (lsp-proxy-java-find-production-file)
      (funcall success (list :files (vector file)))
      (should (= (hash-table-count lsp-proxy-java-files--cache) 0)))
    (should (= (length requests) 3))))

(ert-deftest lsp-proxy-files-new-request-suppresses-old-callbacks ()
  (lsp-proxy-test-files--with-source
    (lsp-proxy-java-find-production-file)
    (let ((old-success success) (old-error failure) (old-timeout timeout))
      (lsp-proxy-java-find-production-file)
      (funcall old-success (list :files (vector file)))
      (funcall old-error '(:message "old"))
      (funcall old-timeout)
      (lsp-proxy-test-files--drain)
      (should-not visits)
      (should-not reports)
      (should (= (hash-table-count lsp-proxy-java-files--cache) 0)))))

(ert-deftest lsp-proxy-files-disconnected-disabled-and-renamed-origins ()
  (lsp-proxy-test-files--with-source
    (dolist (scenario '(connection disabled renamed))
      (lsp-proxy-java-find-production-file)
      (let ((lsp-proxy--connection (if (eq scenario 'connection) '(new) connection))
            (lsp-proxy-mode (not (eq scenario 'disabled)))
            (buffer-file-name (if (eq scenario 'renamed) "/new.java" file)))
        (funcall success (list :files (vector file)))
        (funcall failure '(:message "late"))
        (funcall timeout)
        (lsp-proxy-test-files--drain)))
    (should-not visits)
    (should-not reports)))

(ert-deftest lsp-proxy-files-killed-origin-and-delayed-timer-are-safe ()
  (lsp-proxy-test-files--with-source
    (let ((origin (generate-new-buffer " *production-origin*")))
      (unwind-protect
          (progn
            (with-current-buffer origin
              (setq buffer-file-name file default-directory root)
              (setq-local lsp-proxy-mode t lsp-proxy--buffer-opened t
                          lsp-proxy--workspace-roots (list root))
              (lsp-proxy-java-find-production-file))
            (funcall success (list :files (vector file)))
            (kill-buffer origin)
            (lsp-proxy-test-files--drain)
            (funcall success (list :files (vector file)))
            (funcall failure '(:message "late"))
            (should-not visits)
            (should-not reports))
        (when (buffer-live-p origin) (kill-buffer origin))))))

(ert-deftest lsp-proxy-files-invalidation-does-not-repopulate-stale-cache ()
  (lsp-proxy-test-files--with-source
    (lsp-proxy-java-find-production-file)
    (lsp-proxy-java-clear-file-cache)
    (funcall success (list :files (vector file)))
    (should (= (hash-table-count lsp-proxy-java-files--cache) 0))
    (lsp-proxy-test-files--drain)
    (lsp-proxy-java-find-production-file)
    (funcall success (list :files (vector file)))
    (should (= (hash-table-count lsp-proxy-java-files--cache) 1))
    (lsp-proxy-java-files--after-save)
    (should (= (hash-table-count lsp-proxy-java-files--cache) 0))))

(ert-deftest lsp-proxy-files-empty-cancel-errors-and-fallback-visible ()
  (lsp-proxy-test-files--with-source
    (lsp-proxy-java-find-production-file)
    (funcall success '(:files [] :fallbackModules ["/module"] :warnings ["model error"]))
    (lsp-proxy-test-files--drain)
    (should (= (length reports) 3))
    (funcall failure '(:message "RPC failure"))
    (funcall timeout)
    (should (= (length reports) 5))
    (cl-letf (((symbol-function 'lsp-proxy--completing-read)
               (lambda (&rest _) (signal 'quit nil))))
      (funcall success (list :files (vector file)))
      (lsp-proxy-test-files--drain))
    (should-not visits)
    (should-not markers)))

(ert-deftest lsp-proxy-files-waits-for-existing-minibuffer ()
  (lsp-proxy-test-files--with-source
    (lsp-proxy-java-find-production-file)
    (funcall success (list :files (vector file)))
    (cl-letf (((symbol-function 'active-minibuffer-window) (lambda () t)))
      (let ((timer (pop timers))) (apply (car timer) (cdr timer))))
    (should-not visits)
    (should timers)
    (lsp-proxy-test-files--drain)
    (should visits)))

(ert-deftest lsp-proxy-files-source-and-remote-guards ()
  (lsp-proxy-test-files--with-source
    (let ((lsp-proxy-mode nil))
      (should-error (lsp-proxy-java-find-production-file) :type 'user-error))
    (let ((buffer-file-name "/tmp/readme.md"))
      (should-error (lsp-proxy-java-find-production-file) :type 'user-error))
    (let ((buffer-file-name "/ssh:host:/project/Widget.java"))
      (should-error (lsp-proxy-java-find-production-file) :type 'user-error))
    (should-not requests)))

(ert-deftest lsp-proxy-files-workspace-restart-cancels-completion ()
  (lsp-proxy-test-files--with-source
    (lsp-proxy-java-find-production-file)
    (funcall success (list :files (vector file)))
    (lsp-proxy-java-clear-file-cache t)
    (lsp-proxy-test-files--drain)
    (funcall success (list :files (vector file)))
    (should-not visits)
    (should-not timers)))

(ert-deftest lsp-proxy-files-deleted-candidate-does-not-create-a-file ()
  (lsp-proxy-test-files--with-source
    (lsp-proxy-java-find-production-file)
    (funcall success (list :files (vector file)))
    (delete-file file)
    (lsp-proxy-test-files--drain)
    (should-not visits)
    (should-not markers)
    (should reports)
    (should (= (hash-table-count lsp-proxy-java-files--cache) 0))))
