;;; test-workspace-symbol.el --- Workspace symbol contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'lsp-proxy-utils)
(defvar lsp-proxy-install-dir temporary-file-directory)
;; This isolated batch process replaces transport with stubs below.
(provide 'lsp-proxy-core)
(provide 'lsp-proxy-java)
(require 'lsp-proxy-workspace-symbol)
(require 'lsp-proxy-java-spring)

(defun lsp-proxy-symbol-test--item (uri &optional start)
  (list :language_server_id 17 :language_server_name "spring-boot"
        :lsp_item (list :name "@+ bean" :kind 5 :data '(:token 42)
                        :location (append (list :uri uri)
                                          (when start (list :range (list :start start :end start)))))))

(ert-deftest lsp-proxy-symbol-test-identical-candidates-keep-both-objects ()
  (let* ((one (lsp-proxy-symbol-test--item "file:///Bean.java"))
         (two (copy-tree one))
         (candidates (lsp-proxy-workspace-symbol--candidates (vector one two))))
    (should (= (length candidates) 2))
    (should-not (equal (caar candidates) (caadr candidates)))
    (should (eq (cdar candidates) one))
    (should (eq (cdadr candidates) two))))

(ert-deftest lsp-proxy-symbol-test-url-opens-browser-without-file-or-resolve ()
  (let (opened)
    (cl-letf (((symbol-function 'browse-url) (lambda (uri &rest _) (setq opened uri)))
              ((symbol-function 'find-file-noselect) (lambda (&rest _) (ert-fail "opened URL as file")))
              ((symbol-function 'lsp-proxy-workspace-symbol--resolve) (lambda (&rest _) (ert-fail "resolved URL"))))
      (lsp-proxy-workspace-symbol--jump (lsp-proxy-symbol-test--item "https://localhost:8080/api?a=1"))
      (should (equal opened "https://localhost:8080/api?a=1"))
      (should-error (lsp-proxy-workspace-symbol--jump (lsp-proxy-symbol-test--item opened) t) :type 'user-error))))

(ert-deftest lsp-proxy-symbol-test-resolve-retains-origin-and-data ()
  (let ((lsp-proxy-workspace-symbol--context '(:uri "file:///Origin.java" :params nil))
        captured)
    (cl-letf (((symbol-function 'lsp-proxy--request)
               (lambda (method params &rest _) (setq captured (list method params)) 'resolved)))
      (should (eq (lsp-proxy-workspace-symbol--resolve
                   (lsp-proxy-symbol-test--item "file:///Bean.java")) 'resolved))
      (should (eq (car captured) 'workspaceSymbol/resolve))
      (should (equal (plist-get (cadr captured) :uri) "file:///Origin.java"))
      (should (equal (plist-get (plist-get (cadr captured) :context) :language-server-id) 17))
      (should (equal (plist-get (plist-get (cadr captured) :params) :data) '(:token 42))))))

(ert-deftest lsp-proxy-symbol-test-file-and-jvm-use-location-marker ()
  (with-temp-buffer
    (insert "first\n中文 bean\n")
    (let ((target (current-buffer)))
      (cl-letf (((symbol-function 'find-file-noselect) (lambda (&rest _) target))
                ((symbol-function 'eglot--lsp-position-to-point)
                 (lambda (start)
                   (goto-char (point-min))
                   (forward-line (plist-get start :line))
                   (+ (point) (plist-get start :character)))))
        (dolist (uri '("file:///Bean.java" "jdt://contents/Bean.class" "jar:file:///lib.jar!/Bean.class" "jrt:/java.base/Bean.class"))
          (let ((marker (lsp-proxy-workspace-symbol--jump
                         (lsp-proxy-symbol-test--item uri '(:line 1 :character 3)) t)))
            (should (eq (marker-buffer marker) target))
            (should (equal (buffer-substring marker (+ marker 4)) "bean"))))))))

(ert-deftest lsp-proxy-symbol-test-xref-does-not-open-candidates ()
  (cl-letf (((symbol-function 'lsp-proxy--build-params) (lambda (&rest _) '(:uri "file:///Origin.java")))
            ((symbol-function 'lsp-proxy-workspace-symbol--search)
             (lambda (_) (list (lsp-proxy-symbol-test--item "file:///Bean.java")
                               (lsp-proxy-symbol-test--item "https://localhost:8080/api"))))
            ((symbol-function 'find-file-noselect) (lambda (&rest _) (ert-fail "eager file open"))))
    (let* ((items (xref-backend-apropos 'xref-lsp-proxy "bean"))
           (location (xref-item-location (car items))))
      (should (= (length items) 1))
      (should (equal (xref-location-group location) "file:///Bean.java"))
      (let ((origin (lsp-proxy--workspace-symbol-location-origin location)))
        (setf (lsp-proxy--workspace-symbol-location-origin location) (generate-new-buffer "test-dead"))
        (kill-buffer (lsp-proxy--workspace-symbol-location-origin location))
        (should-error (xref-location-marker location) :type 'user-error)
        (setf (lsp-proxy--workspace-symbol-location-origin location) origin)))))

(ert-deftest lsp-proxy-symbol-test-spring-bundles-selected-version ()
  (let* ((root (make-temp-file "spring-ert" t))
         (lsp-proxy-java-spring-install-dir root)
         (lsp-proxy-java-spring-version "1.62.0")
         (release (expand-file-name "1.62.0" root)))
    (unwind-protect
        (progn
          (make-directory (expand-file-name "extension/jars" release) t)
          (with-temp-file (expand-file-name "extension/jars/sts.jar" release))
          (with-temp-file (expand-file-name "spring-install.json" release)
            (insert "{\"version\":\"1.62.0\",\"bundles\":[\"extension/jars/sts.jar\"]}"))
          (should (equal (lsp-proxy-java-spring-bundles)
                         (list (expand-file-name "extension/jars/sts.jar" release))))
          (let ((lsp-proxy-java-spring-version "2.0.0"))
            (should-not (lsp-proxy-java-spring-bundles))))
      (delete-directory root t))))

(ert-deftest lsp-proxy-symbol-test-live-connection-preserves-envelope-and-process-key ()
  (let (requests)
    (cl-letf (((symbol-function 'lsp-proxy--build-params) (lambda (&rest _) '(:uri "file:///Origin.java")))
              ((symbol-function 'lsp-proxy--request)
               (lambda (_method params &rest _)
                 (push params requests)
                 (when (equal (plist-get (plist-get params :params) :command) "sts/livedata/listProcesses")
                   [(:processKey "local-42" :label "App (42)" :action "sts/livedata/connect")])) )
              ((symbol-function 'completing-read) (lambda (_prompt candidates &rest _) (caar candidates))))
      (lsp-proxy-java-spring-connect-running-app)
      (should (= (length requests) 2))
      (should (equal (plist-get (car requests) :uri) "file:///Origin.java"))
      (should (equal (plist-get (plist-get (car requests) :params) :command) "sts/livedata/connect"))
      (should (equal (plist-get (plist-get (car requests) :params) :arguments) [(:processKey "local-42")])))))

